"use client";

import dayjs from "dayjs";
import "dayjs/locale/vi";

dayjs.locale("vi");
import {
  CalendarDays,
  Grid2x2,
  List,
  Lock,
  LogOut,
  MoreHorizontal,
  Pin,
  Plus,
  Search,
  Settings,
  Share2,
  Trash2,
  UserCircle2,
  Moon,
  StickyNote,
  LayoutGrid,
  X,
  Wifi,
  WifiOff,
} from "lucide-react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { useEffect, useEffectEvent, useMemo, useState, useTransition, useDeferredValue, useRef } from "react";
import { io } from "socket.io-client";
import { api } from "@/lib/api";
import { mockLabels, mockNotes, mockUser } from "@/lib/mock-data";
import type { Label, Note, User } from "@/types";

type ViewMode = "list" | "grid";
type SidebarFilter = "all" | "pinned" | "shared" | "trash";

const tokenStorageKey = "noteflow_token";

function parseChecklist(content: string) {
  return content
    .split("\n")
    .filter((line) => line.startsWith("["))
    .map((line) => ({
      text: line.replace(/^\[[x ]\]\s*/, ""),
      checked: line.startsWith("[x]"),
    }));
}

export function NoteFlowApp() {
  const router = useRouter();
  const [token, setToken] = useState<string | null>(() =>
    typeof window === "undefined" ? null : window.localStorage.getItem(tokenStorageKey),
  );
  const [user, setUser] = useState<User | null>(null);
  const [notes, setNotes] = useState<Note[]>(mockNotes);
  const [labels, setLabels] = useState<Label[]>(mockLabels);
  const [selectedNoteId, setSelectedNoteId] = useState<string | null>(null);
  const [selectedDate, setSelectedDate] = useState(dayjs().format("YYYY-MM-DD"));
  const [search, setSearch] = useState("");
  const [viewMode, setViewMode] = useState<ViewMode>("list");
  const [sidebarFilter, setSidebarFilter] = useState<SidebarFilter>("all");
  const [selectedLabelId, setSelectedLabelId] = useState<string | null>(null);
  const [showAllDates, setShowAllDates] = useState(false);
  const [saveMessage, setSaveMessage] = useState("");
  const [isMounted, setIsMounted] = useState(false);
  const [shareModal, setShareModal] = useState<{
    isOpen: boolean;
    noteId: string;
    link: string;
    publicPermission: string;
    shares: { email: string; permission: string }[];
    newUserEmail: string;
    newUserPermission: string;
    isLoading: boolean;
    isGenerating: boolean;
  }>({ isOpen: false, noteId: "", link: "", publicPermission: "none", shares: [], newUserEmail: "", newUserPermission: "viewer", isLoading: false, isGenerating: false });
  const [isPending, startTransition] = useTransition();
  const deferredSearch = useDeferredValue(search);
  const [sortOrder, setSortOrder] = useState<"newest" | "oldest">("newest");

  const [confirmModal, setConfirmModal] = useState<{
    isOpen: boolean;
    title: string;
    message: string;
    onConfirm: () => void;
    isDestructive?: boolean;
    confirmText?: string;
  }>({ isOpen: false, title: "", message: "", onConfirm: () => {} });

  const [labelModal, setLabelModal] = useState<{
    isOpen: boolean;
    title: string;
    initialName: string;
    initialColor: string;
    onConfirm: (name: string, color: string) => void;
  }>({ isOpen: false, title: "", initialName: "", initialColor: "#4F46E5", onConfirm: () => {} });
  
  const [labelNameInput, setLabelNameInput] = useState("");
  const [labelColorInput, setLabelColorInput] = useState("#4F46E5");

  const [labelContextMenu, setLabelContextMenu] = useState<{
    isOpen: boolean;
    x: number;
    y: number;
    labelId: string;
  }>({ isOpen: false, x: 0, y: 0, labelId: "" });

  const longPressTimer = useRef<NodeJS.Timeout | null>(null);

  const [draft, setDraft] = useState<Note | null>(null);
  const [isOnline, setIsOnline] = useState(true);
  const [showOnlineToast, setShowOnlineToast] = useState(false);
  const [wasOffline, setWasOffline] = useState(false);

  useEffect(() => {
    setIsMounted(true);
    setIsOnline(typeof window !== "undefined" ? window.navigator.onLine : true);

    // Load from cache on mount to avoid hydration mismatch
    const cachedUser = localStorage.getItem("noteflow_cache_user");
    if (cachedUser) setUser(JSON.parse(cachedUser));

    const cachedNotes = localStorage.getItem("noteflow_cache_notes");
    if (cachedNotes) setNotes(JSON.parse(cachedNotes));

    const cachedLabels = localStorage.getItem("noteflow_cache_labels");
    if (cachedLabels) setLabels(JSON.parse(cachedLabels));
  }, []);

  useEffect(() => {
    if (!isOnline) {
      setWasOffline(true);
    } else if (isOnline && wasOffline) {
      setShowOnlineToast(true);
      const timer = setTimeout(() => setShowOnlineToast(false), 3000);
      return () => clearTimeout(timer);
    }
  }, [isOnline, wasOffline]);

  const syncOfflineData = async () => {
    if (!token) return;
    const queueJson = localStorage.getItem("noteflow_offline_queue");
    if (!queueJson) return;
    
    try {
      const queue = JSON.parse(queueJson);
      if (!queue.length) return;
      
      setSaveMessage("Đang đồng bộ dữ liệu ngoại tuyến...");
      
      const remainingQueue = [];
      let successCount = 0;

      for (const action of queue) {
        try {
          if (action.type === 'CREATE_NOTE') {
            await api.createNote(token, action.payload);
          } else if (action.type === 'UPDATE_NOTE') {
            await api.updateNote(token, action.id, action.payload);
          } else if (action.type === 'DELETE_NOTE_PERMANENT') {
            await api.deleteNotePermanently(token, action.id);
          }
          successCount++;
        } catch (e) {
          console.error("Lỗi đồng bộ item", action, e);
          remainingQueue.push(action);
        }
      }
      
      if (remainingQueue.length === 0) {
        localStorage.removeItem("noteflow_offline_queue");
        setSaveMessage("Đã đồng bộ xong dữ liệu ngoại tuyến!");
      } else {
        localStorage.setItem("noteflow_offline_queue", JSON.stringify(remainingQueue));
        setSaveMessage("Một số thay đổi chưa thể đồng bộ, sẽ thử lại sau.");
      }
      
      // Refresh notes list after sync if at least one succeeded
      if (successCount > 0) {
        const response = await api.getNotes(token, "?view=all");
        setNotes(response.notes);
      }
    } catch(e) {
      console.error(e);
    }
  };

  useEffect(() => {
    const handleOnline = () => {
      setIsOnline(true);
      syncOfflineData();
    };
    const handleOffline = () => {
      setIsOnline(false);
      setSaveMessage("Đang ngoại tuyến. Dữ liệu sẽ được lưu nội bộ.");
    };

    window.addEventListener('online', handleOnline);
    window.addEventListener('offline', handleOffline);
    
    // Auto-retry syncing every 10 seconds if there's a queue
    const syncInterval = setInterval(() => {
      if (typeof window !== "undefined" && window.navigator.onLine) {
        const queueJson = localStorage.getItem("noteflow_offline_queue");
        if (queueJson && JSON.parse(queueJson).length > 0) {
          syncOfflineData();
        }
      }
    }, 10000);

    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
      clearInterval(syncInterval);
    };
  }, [token]);

  function enqueueOfflineAction(action: any) {
    if (typeof window === "undefined") return;
    const queueJson = localStorage.getItem("noteflow_offline_queue");
    let queue = queueJson ? JSON.parse(queueJson) : [];
    
    if (action.type === 'UPDATE_NOTE') {
      queue = queue.filter((a: any) => !(a.type === 'UPDATE_NOTE' && a.id === action.id));
    }
    if (action.type === 'DELETE_NOTE_PERMANENT') {
      queue = queue.filter((a: any) => a.id !== action.id);
    }
    
    queue.push(action);
    localStorage.setItem("noteflow_offline_queue", JSON.stringify(queue));
  }

  const persistDraft = useEffectEvent(async (nextDraft: Note) => {
    // Luôn cập nhật local state để UI mượt mà
    setNotes((current) => current.map((note) => (note.id === nextDraft.id ? { ...nextDraft, updatedAt: new Date().toISOString() } : note)));

    if (!token) {
      setSaveMessage("Đang ở chế độ demo (không lưu vào database)");
      return;
    }

    try {
      const response = await api.updateNote(token, nextDraft.id, {
        title: nextDraft.title,
        content: nextDraft.content,
        noteDate: nextDraft.noteDate,
        isPinned: nextDraft.isPinned,
        images: nextDraft.images,
        labelIds: nextDraft.labels.map((label) => label.id),
      });

      setSaveMessage(`Đã tự động lưu lúc ${dayjs().format("HH:mm")}`);
      
      // If we just successfully saved to server, it's a good time to ensure any other offline actions are pushed too.
      const queueJson = localStorage.getItem("noteflow_offline_queue");
      if (queueJson && JSON.parse(queueJson).length > 0) {
        syncOfflineData();
      }
    } catch (error) {
      if (!isOnline || (error as Error).message === "Failed to fetch") {
        enqueueOfflineAction({
          type: "UPDATE_NOTE",
          id: nextDraft.id,
          payload: {
            title: nextDraft.title,
            content: nextDraft.content,
            noteDate: nextDraft.noteDate,
            isPinned: nextDraft.isPinned,
            images: nextDraft.images,
            labelIds: nextDraft.labels.map((label) => label.id),
          }
        });
        setSaveMessage(`Đã lưu ngoại tuyến lúc ${dayjs().format("HH:mm")}`);
      } else {
        setSaveMessage("Không thể lưu. Vui lòng kiểm tra kết nối.");
      }
    }
  });

  useEffect(() => {
    if (typeof window !== "undefined" && !token) {
      router.push("/dang-ky");
      return;
    }

    if (!token) return;

    startTransition(async () => {
      if (typeof window !== "undefined") {
        const queueJson = localStorage.getItem("noteflow_offline_queue");
        if (queueJson && JSON.parse(queueJson).length > 0 && window.navigator.onLine) {
           await syncOfflineData();
           // syncOfflineData already fetches the latest notes, so just fetch user/labels
           try {
             const [me, labelResponse] = await Promise.all([
               api.me(token),
               api.getLabels(token),
             ]);
             setUser(me.user);
             setLabels(labelResponse.labels);
             if (me.user.preferences?.defaultView) setViewMode(me.user.preferences.defaultView);
           } catch(e) {}
           return;
        }
      }

      try {
        const [me, noteResponse, labelResponse] = await Promise.all([
          api.me(token),
          api.getNotes(token, "?view=all"),
          api.getLabels(token),
        ]);
        setUser(me.user);
        setNotes(noteResponse.notes);
        setLabels(labelResponse.labels);
        
        if (me.user.preferences?.defaultView) {
          setViewMode(me.user.preferences.defaultView);
        }
      } catch (err) {
        if (typeof window !== "undefined" && !window.navigator.onLine) {
          setSaveMessage("Bạn đang dùng chế độ ngoại tuyến.");
        } else {
          setSaveMessage("Không thể tải dữ liệu mới nhất. Đang hiển thị bản lưu tạm.");
        }
      }
    });
  }, [token]);

  useEffect(() => {
    if (typeof window !== "undefined") {
      if (user) localStorage.setItem("noteflow_cache_user", JSON.stringify(user));
      localStorage.setItem("noteflow_cache_notes", JSON.stringify(notes));
      localStorage.setItem("noteflow_cache_labels", JSON.stringify(labels));
    }
  }, [user, notes, labels]);


  // Real-time synchronization
  useEffect(() => {
    if (!token || !user?.id) return;
    
    const socketUrl = process.env.NEXT_PUBLIC_API_URL ? process.env.NEXT_PUBLIC_API_URL.replace('/api', '') : "http://localhost:4000";
    const socket = io(socketUrl, {
      query: { userId: user.id },
      withCredentials: true
    });

    socket.on("connect", () => {
      console.log("Socket connected for real-time sync");
    });

    socket.on("note_updated", (data: { note: Note, updatedBy: string }) => {
      // Ignore if we were the ones updating it
      if (data.updatedBy === user.id) return;

      setNotes(prev => {
        const idx = prev.findIndex(n => n.id === data.note.id);
        if (idx !== -1) {
          const updatedList = [...prev];
          updatedList[idx] = { 
            ...data.note, 
            isSharedWithMe: prev[idx].isSharedWithMe, 
            sharedPermission: prev[idx].sharedPermission 
          };
          return updatedList;
        }
        return prev;
      });

      setDraft(current => {
        if (current && current.id === data.note.id) {
          return { 
            ...data.note, 
            isSharedWithMe: current.isSharedWithMe, 
            sharedPermission: current.sharedPermission 
          };
        }
        return current;
      });
    });

    return () => {
      socket.disconnect();
    };
  }, [token, user?.id]);

  const [lastSavedId, setLastSavedId] = useState<string | null>(null);

  useEffect(() => {
    if (!draft?.id || draft.isDeleted) return;
    
    const originalNote = notes.find(n => n.id === draft.id);
    if (!originalNote) return;

    const isChanged = 
      originalNote.title !== draft.title || 
      originalNote.content !== draft.content ||
      originalNote.isPinned !== draft.isPinned ||
      originalNote.noteDate !== draft.noteDate ||
      JSON.stringify(originalNote.labels) !== JSON.stringify(draft.labels);

    // Chỉ lưu nếu có thay đổi thực sự
    if (!isChanged) return;

    const timeout = window.setTimeout(() => {
      persistDraft(draft);
      setLastSavedId(draft.id);
    }, 900);
    return () => window.clearTimeout(timeout);
  }, [draft, notes]);

  const visibleNotes = useMemo(() => {
    return notes.filter((note) => {
      const matchesFilter =
        sidebarFilter === "all"
          ? !note.isDeleted
          : sidebarFilter === "pinned"
            ? note.isPinned && !note.isDeleted && !note.isSharedWithMe
            : sidebarFilter === "shared"
              ? note.isSharedWithMe && !note.isDeleted
              : note.isDeleted;

      const matchesLabel = !selectedLabelId || note.labels.some((l) => l.id === selectedLabelId);
      const matchesDate = showAllDates || sidebarFilter === "trash" ? true : note.noteDate === selectedDate;
      
      const keyword = deferredSearch.toLowerCase();
      const matchesSearch =
        !keyword ||
        note.title.toLowerCase().includes(keyword) ||
        note.content.toLowerCase().includes(keyword) ||
        note.labels.some((label) => label.name.toLowerCase().includes(keyword));

      return matchesFilter && matchesLabel && matchesDate && matchesSearch;
    }).sort((a, b) => {
      if (a.isPinned !== b.isPinned) return a.isPinned ? -1 : 1;
      const order = sortOrder === "newest" ? 1 : -1;
      if (a.noteDate !== b.noteDate) return (dayjs(b.noteDate).valueOf() - dayjs(a.noteDate).valueOf()) * order;
      return (dayjs(b.updatedAt || 0).valueOf() - dayjs(a.updatedAt || 0).valueOf()) * order;
    });
  }, [notes, sidebarFilter, selectedLabelId, selectedDate, showAllDates, deferredSearch, sortOrder]);

  const selectedNote = visibleNotes.find((note) => note.id === selectedNoteId) || draft;

  const listTitle = useMemo(() => {
    if (selectedLabelId) {
      const label = labels.find((l) => l.id === selectedLabelId);
      return label ? `Nhãn: ${label.name}` : "Danh sách ghi chú";
    }
    switch (sidebarFilter) {
      case "pinned": return "Ghi chú đã ghim";
      case "shared": return "Đã chia sẻ với tôi";
      case "trash": return "Thùng rác";
      default: return "Tất cả ghi chú";
    }
  }, [sidebarFilter, selectedLabelId, labels]);

  const days = Array.from({ length: 7 }, (_, index) =>
    dayjs().startOf("week").add(index + 1, "day").format("YYYY-MM-DD"),
  );

  async function createNote() {
    setSidebarFilter("all");
    setSelectedLabelId(null);
    setShowAllDates(true);

    const tempNote: Note = {
      id: crypto.randomUUID(),
      title: "Ghi chú mới",
      content: "Mô tả công việc hoặc ý tưởng tại đây...",
      noteDate: selectedDate,
      isPinned: false,
      isDeleted: false,
      isPasswordProtected: false,
      images: [],
      labels: [],
      updatedAt: new Date().toISOString(),
    };

    setNotes((current) => [tempNote, ...current]);
    setSelectedNoteId(tempNote.id);
    setDraft(tempNote);

    if (!token) return;
    try {
      const response = await api.createNote(token, {
        id: tempNote.id,
        title: tempNote.title,
        content: tempNote.content,
        noteDate: tempNote.noteDate,
        labelIds: tempNote.labels.map((label) => label.id),
      });
      setNotes((current) => current.map((note) => (note.id === tempNote.id ? response.note : note)));
      setSelectedNoteId(response.note.id);
      setDraft(response.note);
    } catch (error) {
      if (!isOnline || (error as Error).message === "Failed to fetch") {
        enqueueOfflineAction({
          type: "CREATE_NOTE",
          payload: {
            id: tempNote.id,
            title: tempNote.title,
            content: tempNote.content,
            noteDate: tempNote.noteDate,
            labelIds: tempNote.labels.map((label) => label.id),
          }
        });
        setSaveMessage("Đã tạo ngoại tuyến.");
      } else {
        setSaveMessage(error instanceof Error ? error.message : "Không thể tạo ghi chú mới.");
      }
    }
  }

  function removeNote(id: string) {
    setConfirmModal({
      isOpen: true,
      title: "Chuyển vào thùng rác",
      message: "Bạn có chắc chắn muốn chuyển ghi chú này vào thùng rác không?",
      confirmText: "Chuyển",
      isDestructive: true,
      onConfirm: async () => {
        setNotes((current) => current.map((note) => (note.id === id ? { ...note, isDeleted: true } : note)));
        if (token) {
          try {
            await api.deleteNote(token, id);
          } catch(error) {
            if (!isOnline || (error as Error).message === "Failed to fetch") {
              enqueueOfflineAction({ type: "UPDATE_NOTE", id: id, payload: { isDeleted: true } });
            }
          }
        }
        setSidebarFilter("trash");
        setSaveMessage("Đã chuyển ghi chú vào thùng rác.");
        setConfirmModal(prev => ({ ...prev, isOpen: false }));
      }
    });
  }

  async function restoreNote(id: string) {
    setNotes((current) => current.map((note) => (note.id === id ? { ...note, isDeleted: false } : note)));
    if (token) {
      try {
        await api.updateNote(token, id, { isDeleted: false });
      } catch(error) {
        if (!isOnline || (error as Error).message === "Failed to fetch") {
          enqueueOfflineAction({ type: "UPDATE_NOTE", id: id, payload: { isDeleted: false } });
        }
      }
    }
    setSidebarFilter("all");
    setSaveMessage("Đã khôi phục ghi chú.");
  }

  function removeNotePermanently(id: string) {
    setConfirmModal({
      isOpen: true,
      title: "Xóa vĩnh viễn",
      message: "Ghi chú này sẽ bị xóa vĩnh viễn và không thể khôi phục. Bạn có chắc chắn?",
      confirmText: "Xóa",
      isDestructive: true,
      onConfirm: async () => {
        setNotes((current) => current.filter((note) => note.id !== id));
        if (draft?.id === id) setDraft(null);
        if (token) {
          try {
            await api.deleteNotePermanently(token, id);
          } catch(error) {
            if (!isOnline || (error as Error).message === "Failed to fetch") {
              enqueueOfflineAction({ type: "DELETE_NOTE_PERMANENT", id: id });
            }
          }
        }
        setSaveMessage("Đã xóa vĩnh viễn.");
        setConfirmModal(prev => ({ ...prev, isOpen: false }));
      }
    });
  }

  async function togglePin(note: Note) {
    const next = { ...note, isPinned: !note.isPinned };
    setNotes((current) => current.map((item) => (item.id === note.id ? next : item)));
    setDraft(next);

    if (token) {
      try {
        await api.updateNote(token, note.id, { isPinned: next.isPinned });
      } catch(error) {
        if (!isOnline || (error as Error).message === "Failed to fetch") {
          enqueueOfflineAction({ type: "UPDATE_NOTE", id: note.id, payload: { isPinned: next.isPinned } });
        }
      }
    }
  }

  async function addLabelToNote(label: Label) {
    if (!draft) return;
    if (draft.labels.some((l) => l.id === label.id)) return;
    const next = { ...draft, labels: [...draft.labels, label] };
    setDraft(next);
  }

  async function removeLabelFromNote(labelId: string) {
    if (!draft) return;
    const next = { ...draft, labels: draft.labels.filter((l) => l.id !== labelId) };
    setDraft(next);
  }

  function toggleSidebarFilter(filter: SidebarFilter) {
    setSidebarFilter(filter);
    setSelectedLabelId(null);
  }

  function selectLabel(labelId: string) {
    setSelectedLabelId(labelId);
    setSidebarFilter("all");
  }

  function editLabel(labelId: string) {
    const label = labels.find(l => l.id === labelId);
    if (!label) return;
    
    setLabelNameInput(label.name);
    setLabelColorInput(label.color || "#4F46E5");
    setLabelModal({
      isOpen: true,
      title: "Chỉnh sửa nhãn",
      initialName: label.name,
      initialColor: label.color || "#4F46E5",
      onConfirm: async (name, color) => {
        if (!name.trim()) return;
        setLabels(prev => prev.map(l => l.id === labelId ? { ...l, name: name.trim(), color } : l));
        setNotes(prev => prev.map(n => ({
          ...n,
          labels: n.labels.map(l => l.id === labelId ? { ...l, name: name.trim(), color } : l)
        })));
        if (draft) {
          setDraft(prev => prev ? ({
            ...prev,
            labels: prev.labels.map(l => l.id === labelId ? { ...l, name: name.trim(), color } : l)
          }) : null);
        }
        if (token) {
          try { await api.updateLabel(token, labelId, { name: name.trim(), color }); }
          catch (err) { setSaveMessage("Không thể cập nhật nhãn trên server."); }
        }
        setLabelModal(prev => ({ ...prev, isOpen: false }));
      }
    });
  }

  function deleteLabel(labelId: string) {
    setConfirmModal({
      isOpen: true,
      title: "Xóa nhãn",
      message: "Bạn có chắc chắn muốn xóa nhãn này? Ghi chú chứa nhãn này sẽ không bị xóa.",
      confirmText: "Xóa nhãn",
      isDestructive: true,
      onConfirm: async () => {
        setLabels(prev => prev.filter(l => l.id !== labelId));
        if (selectedLabelId === labelId) setSelectedLabelId(null);
        setNotes(prev => prev.map(n => ({ ...n, labels: n.labels.filter(l => l.id !== labelId) })));
        if (draft) {
          setDraft(prev => prev ? ({ ...prev, labels: prev.labels.filter(l => l.id !== labelId) }) : null);
        }
        if (token) {
          try { await api.deleteLabel(token, labelId); }
          catch (err) { setSaveMessage("Không thể xóa nhãn trên server."); }
        }
        setConfirmModal(prev => ({ ...prev, isOpen: false }));
      }
    });
  }

  const handleLabelContextMenu = (e: React.MouseEvent, labelId: string) => {
    e.preventDefault();
    setLabelContextMenu({ isOpen: true, x: e.clientX, y: e.clientY, labelId });
  };

  const handleLabelTouchStart = (e: React.TouchEvent, labelId: string) => {
    const touch = e.touches[0];
    longPressTimer.current = setTimeout(() => {
      setLabelContextMenu({ isOpen: true, x: touch.clientX, y: touch.clientY, labelId });
    }, 500);
  };

  const handleLabelTouchEnd = () => {
    if (longPressTimer.current) clearTimeout(longPressTimer.current);
  };

  async function openShareModal(note: Note) {
    if (!token) {
      setShareModal(prev => ({ ...prev, isOpen: true, noteId: note.id, link: "Chế độ demo: http://localhost:3000/chia-se/demo-token", publicPermission: "none", shares: [] }));
      return;
    }
    
    setShareModal(prev => ({ ...prev, isOpen: true, noteId: note.id, isLoading: true, link: note.shareToken ? `${window.location.origin}/chia-se/${note.shareToken}` : "" }));
    try {
      const res = await api.getNoteShares(token, note.id);
      setShareModal(prev => ({ 
        ...prev, 
        isLoading: false,
        publicPermission: res.publicPermission,
        link: res.shareToken ? `${window.location.origin}/chia-se/${res.shareToken}` : "",
        shares: res.shares || []
      }));
    } catch(e) {
      setShareModal(prev => ({ ...prev, isLoading: false }));
    }
  }

  async function generateShareLink() {
    if (!shareModal.noteId) return;
    
    if (!token) {
      setShareModal(prev => ({ ...prev, link: "Chế độ demo: http://localhost:3000/chia-se/demo-token" }));
      return;
    }
    
    setShareModal(prev => ({ ...prev, isGenerating: true }));
    try {
      const response = await api.shareNote(token, shareModal.noteId);
      const url = response.shareUrl;
      const shareToken = url.split('/').pop() || "";
      
      setNotes(prev => prev.map(n => n.id === shareModal.noteId ? { ...n, shareToken } : n));
      if (draft?.id === shareModal.noteId) {
        setDraft(prev => prev ? { ...prev, shareToken } : null);
      }
      
      setShareModal(prev => ({ ...prev, link: url, isGenerating: false }));
    } catch (error) {
      setShareModal(prev => ({ ...prev, isGenerating: false }));
      setSaveMessage(error instanceof Error ? error.message : "Không thể tạo liên kết chia sẻ.");
    }
  }

  function logout() {
    window.localStorage.removeItem(tokenStorageKey);
    setToken(null);
    setUser(mockUser);
    setNotes(mockNotes);
    setLabels(mockLabels);
    setSaveMessage("Đã đăng xuất. Giao diện quay về chế độ demo.");
    router.push("/dang-nhap");
  }

  function selectNote(note: Note) {
    setSelectedNoteId(note.id);
    setDraft(note);
  }

  return (
    <main className="dashboard-shell">
      <nav className="narrow-sidebar">
        <div className="nav-top">
          <div className="app-icon">
            <StickyNote size={24} />
          </div>
        </div>
        <div className="nav-bottom">
          <button className="narrow-btn" onClick={logout} title="Đăng xuất">
            <LogOut size={20} />
          </button>
          <button className="narrow-btn" onClick={() => {}}>
            <Settings size={20} />
          </button>
          <button className="narrow-btn" onClick={() => {}}>
            <Moon size={20} />
          </button>
        </div>
      </nav>

      <aside className="sidebar">
        <div className="brand-block">
          <h1>NoteFlow</h1>
        </div>

        <button className="primary-button" onClick={createNote}>
          <Plus size={18} />
          Ghi chú mới
        </button>

        <nav className="sidebar-nav">
          <button className={sidebarFilter === "all" && !selectedLabelId ? "active" : ""} onClick={() => toggleSidebarFilter("all")}>
            <LayoutGrid size={18} />
            Tất cả ghi chú
          </button>
          <button className={sidebarFilter === "pinned" && !selectedLabelId ? "active" : ""} onClick={() => { setSidebarFilter("pinned"); setSelectedLabelId(null); }}>
            <Pin size={18} />
            Đã ghim
          </button>
          <button className={sidebarFilter === "shared" && !selectedLabelId ? "active" : ""} onClick={() => { setSidebarFilter("shared"); setSelectedLabelId(null); }}>
            <Share2 size={18} />
            Đã chia sẻ với tôi
          </button>
          <button className={sidebarFilter === "trash" && !selectedLabelId ? "active" : ""} onClick={() => { setSidebarFilter("trash"); setSelectedLabelId(null); }}>
            <Trash2 size={18} />
            Thùng rác
          </button>
        </nav>

        <div className="sidebar-section">
          <div className="section-head">
            <span>Nhãn</span>
            <button type="button" style={{ color: "var(--text-muted)", fontSize: "1.2rem", cursor: "pointer" }} onClick={() => {
              setLabelNameInput("");
              setLabelColorInput("#" + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0'));
              setLabelModal({
                isOpen: true,
                title: "Thêm nhãn mới",
                initialName: "",
                initialColor: "#4F46E5",
                onConfirm: async (labelName, color) => {
                  if (!labelName.trim()) return;
                  const randomColor = color || ("#" + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0'));
                  if (token) {
                    try {
                      const response = await api.createLabel(token, { name: labelName.trim(), color: randomColor });
                      setLabels(prev => [...prev, response.label]);
                    } catch (err) {
                      setSaveMessage("Không thể tạo nhãn mới trên server.");
                    }
                  } else {
                    setLabels(prev => [...prev, { id: crypto.randomUUID(), name: labelName.trim(), color: randomColor }]);
                  }
                  setLabelModal(prev => ({ ...prev, isOpen: false }));
                }
              });
            }}>+</button>
          </div>
          <div className="label-list">
            {labels.map((label) => (
              <div 
                className={`label-row ${selectedLabelId === label.id ? "active" : ""}`} 
                key={label.id}
                onClick={() => selectLabel(label.id)}
                onContextMenu={(e) => handleLabelContextMenu(e, label.id)}
                onTouchStart={(e) => handleLabelTouchStart(e, label.id)}
                onTouchEnd={handleLabelTouchEnd}
                onTouchCancel={handleLabelTouchEnd}
                onTouchMove={handleLabelTouchEnd}
                style={{ cursor: "pointer", userSelect: "none" }}
              >
                <span className="dot" style={{ background: label.color }} />
                <span>{label.name}</span>
                <strong>{label.noteCount ?? notes.filter((note) => note.labels.some((item) => item.id === label.id)).length}</strong>
              </div>
            ))}
          </div>
        </div>
      </aside>

      <section className="workspace">
        <header className="topbar">
          <label className="search-box">
            <Search size={18} />
            <input
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Tìm kiếm ghi chú..."
            />
            <span>⌘ K</span>
          </label>

          <div className="topbar-actions">
            {saveMessage && <span className="save-status">{saveMessage}</span>}
            <div className="view-toggle">
              <button className={viewMode === "grid" ? "active" : ""} onClick={() => setViewMode("grid")}>
                <Grid2x2 size={18} />
              </button>
              <button className={viewMode === "list" ? "active" : ""} onClick={() => setViewMode("list")}>
                <List size={18} />
              </button>
            </div>
            <button 
              className={`date-filter ${showAllDates ? "active" : ""}`}
              onClick={() => setShowAllDates(!showAllDates)}
            >
              <CalendarDays size={18} />
              {showAllDates ? "Tất cả các ngày" : dayjs(selectedDate).format("DD/MM/YYYY")}
            </button>
          </div>
        </header>

        <section className="content-grid">
          <div className="note-column">
            <div className="column-head">
              <div>
                <h2>{listTitle}</h2>
                <p>{visibleNotes.length} ghi chú hiện có</p>
              </div>
              <span style={{ userSelect: "none" }} onClick={() => !isPending && setSortOrder(prev => prev === "newest" ? "oldest" : "newest")}>
                {isPending ? "Đang đồng bộ..." : sortOrder === "newest" ? "Mới nhất" : "Cũ nhất"}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ transform: sortOrder === "oldest" ? "rotate(180deg)" : "none", transition: "transform 0.2s" }}><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </div>

            <div className="notes-list">
              {visibleNotes.map((note) => (
                <article
                  key={note.id}
                  className={`note-card ${selectedNoteId === note.id ? "selected" : ""}`}
                  onClick={() => selectNote(note)}
                >
                  <div className="note-card-head">
                    <h3>{note.title}</h3>
                    {note.isPinned && <Pin size={16} className="pin-icon" />}
                  </div>
                  <p>{note.content.slice(0, 100)}{note.content.length > 100 ? "..." : ""}</p>
                  <div className="note-card-meta">
                    <CalendarDays size={14} />
                    <span>{dayjs(note.noteDate).format("DD/MM/YYYY")}</span>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div className="editor-column">
            {selectedNote ? (
              <>
                <div className="editor-toolbar">
                  <div className="editor-date" style={{ position: "relative", opacity: draft?.isDeleted ? 0.7 : 1 }}>
                    <CalendarDays size={18} />
                    <span>{dayjs(draft?.noteDate).format("DD/MM/YYYY")}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ marginLeft: 4 }}><path d="m6 9 6 6 6-6"/></svg>
                    {!draft?.isDeleted && (
                      <input 
                        type="date"
                        value={draft?.noteDate || ""}
                        onChange={(e) => setDraft(current => current ? { ...current, noteDate: e.target.value } : null)}
                        style={{ position: "absolute", top: 0, left: 0, right: 0, bottom: 0, opacity: 0, cursor: "pointer", width: "100%", height: "100%" }}
                      />
                    )}
                  </div>
                  <div className="toolbar-actions">
                    {selectedNote.isDeleted ? (
                      <>
                        <button onClick={() => restoreNote(selectedNote.id)} title="Khôi phục ghi chú" style={{ color: 'var(--success)', fontWeight: 500 }}>
                          Khôi phục
                        </button>
                        <button onClick={() => removeNotePermanently(selectedNote.id)} title="Xóa vĩnh viễn" style={{ color: 'var(--danger)', fontWeight: 500 }}>
                          Xóa vĩnh viễn
                        </button>
                      </>
                    ) : (
                      <>
                        <button onClick={() => togglePin(selectedNote)} title="Ghim ghi chú">
                          <Pin size={18} style={{ fill: selectedNote.isPinned ? "currentColor" : "none" }} />
                        </button>
                        {!selectedNote.isSharedWithMe && (
                          <button onClick={() => openShareModal(selectedNote)} title="Chia sẻ">
                            <Share2 size={18} />
                          </button>
                        )}
                        {!selectedNote.isSharedWithMe && (
                          <button onClick={() => removeNote(selectedNote.id)} title="Xóa">
                            <Trash2 size={18} />
                          </button>
                        )}
                        <button>
                          <MoreHorizontal size={18} />
                        </button>
                      </>
                    )}
                  </div>
                </div>

                {draft?.isDeleted && (
                  <div style={{ background: '#fef2f2', color: '#dc2626', padding: '12px 16px', borderRadius: '8px', marginBottom: '16px', fontSize: '0.9rem' }}>
                    Ghi chú này đang nằm trong thùng rác. Bạn cần khôi phục để có thể chỉnh sửa.
                  </div>
                )}

                <div className="title-area" style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
                  <input
                    type="text"
                    className="title-input"
                    value={draft?.title || ""}
                    onChange={(event) => setDraft((current) => current ? ({ ...current, title: event.target.value }) : null)}
                    placeholder="Tiêu đề ghi chú"
                    disabled={draft?.isDeleted || (selectedNote.isSharedWithMe && selectedNote.sharedPermission === 'viewer')}
                  />
                  {selectedNote.isSharedWithMe && selectedNote.sharedPermission === 'viewer' && (
                    <span style={{ 
                      background: 'var(--panel)', 
                      color: 'var(--text-muted)', 
                      fontSize: '0.75rem', 
                      padding: '4px 8px', 
                      borderRadius: 4, 
                      border: '1px solid var(--border)',
                      whiteSpace: 'nowrap'
                    }}>Chỉ xem</span>
                  )}
                </div>

                <div className="tag-row">
                  {draft?.labels.map((label) => (
                    <span className="tag" key={label.id} style={{ background: `${label.color}15`, color: label.color }}>
                      {label.name}
                      <X size={12} style={{ marginLeft: 4, cursor: "pointer" }} onClick={() => removeLabelFromNote(label.id)} />
                    </span>
                  ))}
                  <div className="add-tag-container" style={{ position: "relative" }}>
                    <span className="add-tag" onClick={() => {
                      if (draft?.isDeleted) return;
                      setLabelNameInput("");
                      setLabelColorInput("#" + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0'));
                      setLabelModal({
                        isOpen: true,
                        title: "Thêm nhãn cho ghi chú",
                        initialName: "",
                        initialColor: "#4F46E5",
                        onConfirm: async (labelName, color) => {
                          if (!labelName.trim()) return;
                          const existing = labels.find(l => l.name.toLowerCase() === labelName.trim().toLowerCase());
                          if (existing) {
                            addLabelToNote(existing);
                          } else {
                            const randomColor = color || ("#" + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0'));
                            if (token) {
                              try {
                                const response = await api.createLabel(token, { name: labelName.trim(), color: randomColor });
                                setLabels(prev => [...prev, response.label]);
                                addLabelToNote(response.label);
                              } catch (err) {
                                setSaveMessage("Không thể tạo nhãn mới trên server.");
                              }
                            } else {
                              const newLabel: Label = { id: crypto.randomUUID(), name: labelName.trim(), color: randomColor };
                              setLabels(prev => [...prev, newLabel]);
                              addLabelToNote(newLabel);
                            }
                          }
                          setLabelModal(prev => ({ ...prev, isOpen: false }));
                        }
                      });
                    }}>
                      <Plus size={16} /> Thêm nhãn
                    </span>
                  </div>
                  {draft?.isPasswordProtected ? (
                    <span className="tag" style={{ background: "#F1F5F9", color: "#64748B" }}>
                      <Lock size={12} style={{ marginRight: 4 }} />
                      Bảo vệ
                    </span>
                  ) : null}
                </div>

                <div className="rich-content">
                  <textarea
                    className="content-input"
                    value={draft?.content || ""}
                    onChange={(event) => setDraft((current) => current ? ({ ...current, content: event.target.value }) : null)}
                    placeholder="Bắt đầu viết ghi chú của bạn..."
                    readOnly={draft?.isDeleted || (selectedNote.isSharedWithMe && selectedNote.sharedPermission === 'viewer')}
                  />
                  
                  {draft && parseChecklist(draft.content).length ? (
                    <div className="checklist-preview">
                      <div className="checklist-items">
                        {parseChecklist(draft.content).map((item, index) => (
                          <label key={`${item.text}-${index}`} className="checklist-item">
                            <input type="checkbox" checked={item.checked} readOnly />
                            <span>{item.text}</span>
                          </label>
                        ))}
                      </div>
                    </div>
                  ) : null}
                </div>

                <footer className="editor-footer">
                  <span>Cập nhật {isMounted ? dayjs(draft?.updatedAt || new Date()).format("HH:mm") : "--:--"}</span>
                  <span>{draft?.content.split(/\s+/).filter(w => w.length > 0).length || 0} từ</span>
                </footer>
              </>
            ) : (
              <div className="empty-card">Chọn một ghi chú để xem chi tiết.</div>
            )}
          </div>
        </section>
      </section>

      {/* Confirm Modal */}
      {confirmModal.isOpen && (
        <div className="modal-overlay" onClick={() => setConfirmModal(prev => ({ ...prev, isOpen: false }))}>
          <div className="modal-content" onClick={e => e.stopPropagation()}>
            <div className="modal-title">{confirmModal.title}</div>
            <div className="modal-message">{confirmModal.message}</div>
            <div className="modal-actions">
              <button className="modal-btn cancel" onClick={() => setConfirmModal(prev => ({ ...prev, isOpen: false }))}>Hủy</button>
              <button className={`modal-btn ${confirmModal.isDestructive ? 'danger' : 'confirm'}`} onClick={confirmModal.onConfirm}>
                {confirmModal.confirmText || "Đồng ý"}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Label Modal */}
      {labelModal.isOpen && (
        <div className="modal-overlay" onClick={() => setLabelModal(prev => ({ ...prev, isOpen: false }))}>
          <div className="modal-content" onClick={e => e.stopPropagation()}>
            <div className="modal-title">{labelModal.title}</div>
            <label style={{ display: 'flex', flexDirection: 'column', gap: 8, fontSize: '0.95rem' }}>
              Tên nhãn:
              <input 
                autoFocus
                className="modal-input" 
                value={labelNameInput} 
                onChange={e => setLabelNameInput(e.target.value)} 
                placeholder="Nhập tên nhãn..." 
                onKeyDown={e => {
                  if (e.key === 'Enter') labelModal.onConfirm(labelNameInput, labelColorInput);
                  if (e.key === 'Escape') setLabelModal(prev => ({ ...prev, isOpen: false }));
                }}
              />
            </label>
            <label style={{ display: 'flex', flexDirection: 'column', gap: 8, fontSize: '0.95rem', marginTop: 8 }}>
              Màu sắc:
              <div style={{ display: 'flex', gap: 12, alignItems: 'center' }}>
                <input 
                  type="color"
                  value={labelColorInput} 
                  onChange={e => setLabelColorInput(e.target.value)} 
                  style={{ width: 40, height: 40, padding: 0, border: 'none', borderRadius: 8, cursor: 'pointer', background: 'none' }}
                />
                <span style={{ color: 'var(--text-muted)', fontFamily: 'monospace' }}>{labelColorInput.toUpperCase()}</span>
              </div>
            </label>
            <div className="modal-actions" style={{ marginTop: 16 }}>
              <button className="modal-btn cancel" onClick={() => setLabelModal(prev => ({ ...prev, isOpen: false }))}>Hủy</button>
              <button className="modal-btn confirm" onClick={() => labelModal.onConfirm(labelNameInput, labelColorInput)}>Lưu</button>
            </div>
          </div>
        </div>
      )}

      {/* Label Context Menu */}
      {labelContextMenu.isOpen && (
        <>
          <div 
            style={{ position: 'fixed', top: 0, left: 0, right: 0, bottom: 0, zIndex: 999 }}
            onClick={() => setLabelContextMenu(prev => ({ ...prev, isOpen: false }))}
            onContextMenu={(e) => { e.preventDefault(); setLabelContextMenu(prev => ({ ...prev, isOpen: false })); }}
          />
          <div 
            style={{ 
              position: 'fixed', 
              top: Math.min(labelContextMenu.y, typeof window !== 'undefined' ? window.innerHeight - 100 : labelContextMenu.y), 
              left: Math.min(labelContextMenu.x, typeof window !== 'undefined' ? window.innerWidth - 160 : labelContextMenu.x), 
              zIndex: 1000,
              background: 'var(--panel)',
              border: '1px solid var(--border)',
              borderRadius: 'var(--radius-md)',
              boxShadow: 'var(--shadow-lg)',
              display: 'flex',
              flexDirection: 'column',
              minWidth: 150,
              padding: 4
            }}
          >
            <button 
              style={{ padding: '10px 16px', textAlign: 'left', width: '100%', borderRadius: '4px', fontSize: '0.9rem', color: 'var(--text)' }}
              onMouseEnter={e => e.currentTarget.style.background = 'var(--accent-soft)'}
              onMouseLeave={e => e.currentTarget.style.background = 'transparent'}
              onClick={(e) => {
                e.stopPropagation();
                setLabelContextMenu(prev => ({ ...prev, isOpen: false }));
                editLabel(labelContextMenu.labelId);
              }}
            >
              Chỉnh sửa nhãn
            </button>
            <button 
              style={{ padding: '10px 16px', textAlign: 'left', width: '100%', borderRadius: '4px', fontSize: '0.9rem', color: '#DC2626' }}
              onMouseEnter={e => e.currentTarget.style.background = '#FEE2E2'}
              onMouseLeave={e => e.currentTarget.style.background = 'transparent'}
              onClick={(e) => {
                e.stopPropagation();
                setLabelContextMenu(prev => ({ ...prev, isOpen: false }));
                deleteLabel(labelContextMenu.labelId);
              }}
            >
              Xóa nhãn
            </button>
          </div>
        </>
      )}

      {/* Share Modal */}
      {shareModal.isOpen && (
        <div className="modal-overlay" onClick={() => setShareModal(prev => ({ ...prev, isOpen: false }))}>
          <div className="modal-content" onClick={e => e.stopPropagation()} style={{ minWidth: 400 }}>
            <div className="modal-title">Chia sẻ ghi chú</div>
            {shareModal.isLoading ? (
              <div style={{ padding: 20, textAlign: 'center' }}>Đang tải dữ liệu...</div>
            ) : (
              <>
                {/* 1. Share via email */}
                <div style={{ marginBottom: 16 }}>
                  <label style={{ fontSize: '0.9rem', fontWeight: 500, display: 'block', marginBottom: 8 }}>Thêm người và nhóm</label>
                  <div style={{ display: 'flex', gap: 8 }}>
                    <input 
                      className="modal-input" 
                      placeholder="Thêm địa chỉ email..." 
                      value={shareModal.newUserEmail}
                      onChange={e => setShareModal(prev => ({ ...prev, newUserEmail: e.target.value }))}
                    />
                    <select 
                      className="modal-input" 
                      style={{ width: 'auto' }}
                      value={shareModal.newUserPermission}
                      onChange={e => setShareModal(prev => ({ ...prev, newUserPermission: e.target.value }))}
                    >
                      <option value="viewer">Người xem</option>
                      <option value="editor">Người chỉnh sửa</option>
                    </select>
                    <button 
                      className="modal-btn confirm" 
                      onClick={async () => {
                        if (!shareModal.newUserEmail.trim() || !token) return;
                        try {
                          await api.addNoteShareUser(token, shareModal.noteId, shareModal.newUserEmail, shareModal.newUserPermission);
                          const res = await api.getNoteShares(token, shareModal.noteId);
                          setShareModal(prev => ({ ...prev, shares: res.shares || [], newUserEmail: "" }));
                        } catch (e: any) {
                          alert(e.message || "Lỗi chia sẻ");
                        }
                      }}
                    >Thêm</button>
                  </div>
                </div>

                {/* 2. List shared users */}
                {shareModal.shares.length > 0 && (
                  <div style={{ marginBottom: 16 }}>
                    <label style={{ fontSize: '0.9rem', fontWeight: 500, display: 'block', marginBottom: 8 }}>Những người có quyền truy cập</label>
                    <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                      {shareModal.shares.map(share => (
                        <div key={share.email} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', background: 'var(--panel)', padding: '8px 12px', borderRadius: 6 }}>
                          <span style={{ fontSize: '0.9rem' }}>{share.email}</span>
                          <div style={{ display: 'flex', gap: 8, alignItems: 'center' }}>
                            <select 
                              className="modal-input" 
                              style={{ width: 'auto', padding: '4px 8px', height: 'auto', fontSize: '0.85rem' }}
                              value={share.permission}
                              onChange={async (e) => {
                                if (!token) return;
                                try {
                                  await api.addNoteShareUser(token, shareModal.noteId, share.email, e.target.value);
                                  setShareModal(prev => ({ ...prev, shares: prev.shares.map(s => s.email === share.email ? { ...s, permission: e.target.value } : s) }));
                                } catch (err) {}
                              }}
                            >
                              <option value="viewer">Người xem</option>
                              <option value="editor">Người chỉnh sửa</option>
                            </select>
                            <button 
                              style={{ background: 'none', border: 'none', color: '#DC2626', cursor: 'pointer', fontSize: '0.85rem' }}
                              onClick={async () => {
                                if (!token) return;
                                try {
                                  await api.removeNoteShareUser(token, shareModal.noteId, share.email);
                                  setShareModal(prev => ({ ...prev, shares: prev.shares.filter(s => s.email !== share.email) }));
                                } catch (err) {}
                              }}
                            >Gỡ</button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* 3. Public link */}
                <div style={{ borderTop: '1px solid var(--border)', paddingTop: 16, marginTop: 16 }}>
                  <label style={{ fontSize: '0.9rem', fontWeight: 500, display: 'block', marginBottom: 8 }}>Quyền truy cập chung</label>
                  <div style={{ display: 'flex', gap: 8, alignItems: 'center', marginBottom: 12 }}>
                    <select 
                      className="modal-input" 
                      value={shareModal.publicPermission}
                      onChange={async (e) => {
                        const newPerm = e.target.value;
                        if (!token) return;
                        setShareModal(prev => ({ ...prev, publicPermission: newPerm }));
                        try {
                          await api.updatePublicPermission(token, shareModal.noteId, newPerm);
                          if (newPerm !== 'none' && !shareModal.link) {
                            await generateShareLink();
                          }
                        } catch (err) {}
                      }}
                    >
                      <option value="none">Bị hạn chế</option>
                      <option value="viewer">Bất kỳ ai có liên kết (Người xem)</option>
                      <option value="editor">Bất kỳ ai có liên kết (Người chỉnh sửa)</option>
                    </select>
                  </div>
                  
                  {shareModal.publicPermission !== 'none' && shareModal.link && (
                    <div style={{ display: 'flex', gap: 8 }}>
                      <input 
                        className="modal-input" 
                        value={shareModal.link} 
                        readOnly 
                        onClick={e => (e.target as HTMLInputElement).select()}
                      />
                      <button 
                        className="modal-btn confirm" 
                        onClick={() => {
                          navigator.clipboard.writeText(shareModal.link);
                          setSaveMessage("Đã copy liên kết!");
                          setTimeout(() => setSaveMessage(""), 2000);
                        }}
                        style={{ flexShrink: 0 }}
                      >
                        Copy link
                      </button>
                    </div>
                  )}
                </div>

                <div className="modal-actions" style={{ marginTop: 24 }}>
                  <button className="modal-btn confirm" onClick={() => setShareModal(prev => ({ ...prev, isOpen: false }))}>Xong</button>
                </div>
              </>
            )}
          </div>
        </div>
      )}

      {/* Cảnh báo trạng thái mạng */}
      {!isOnline && (
        <div style={{
          position: "fixed",
          bottom: "24px",
          left: "24px",
          backgroundColor: "#EF4444", // Đỏ cảnh báo
          color: "white",
          padding: "10px 16px",
          borderRadius: "8px",
          display: "flex",
          alignItems: "center",
          gap: "8px",
          boxShadow: "0 4px 12px rgba(0,0,0,0.15)",
          zIndex: 9999,
          fontSize: "0.9rem",
          fontWeight: 500,
          animation: "slideUp 0.3s ease-out"
        }}>
          <WifiOff size={18} />
          Đang ngoại tuyến
        </div>
      )}
      
      {isOnline && showOnlineToast && (
        <div style={{
          position: "fixed",
          bottom: "24px",
          left: "24px",
          backgroundColor: "#10B981", // Xanh lá
          color: "white",
          padding: "10px 16px",
          borderRadius: "8px",
          display: "flex",
          alignItems: "center",
          gap: "8px",
          boxShadow: "0 4px 12px rgba(0,0,0,0.15)",
          zIndex: 9999,
          fontSize: "0.9rem",
          fontWeight: 500,
          animation: "slideUp 0.3s ease-out"
        }}>
          <Wifi size={18} />
          Đã khôi phục kết nối mạng
        </div>
      )}

      <style jsx global>{`
        @keyframes slideUp {
          from {
            opacity: 0;
            transform: translateY(20px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      `}</style>
    </main>
  );
}
