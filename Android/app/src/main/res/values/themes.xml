<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Material 3 Light) -->
    <style name="Theme.NoteFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <!-- Auth Theme with tinted status bar -->
    <style name="Theme.NoteFlow.Auth" parent="Theme.NoteFlow">
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Custom Shopee-style Bottom Navigation (Classic Material Design with tight icon-text gap) -->
    <style name="Widget.NoteFlow.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">22dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.NoteFlow.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.NoteFlow.BottomNav.Inactive</item>
    </style>

    <style name="TextAppearance.NoteFlow.BottomNav.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.NoteFlow.BottomNav.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
