<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Material 3 Light) -->
    <style name="Theme.NoteFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <!-- Auth Theme with tinted status bar -->
    <style name="Theme.NoteFlow.Auth" parent="Theme.NoteFlow">
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
