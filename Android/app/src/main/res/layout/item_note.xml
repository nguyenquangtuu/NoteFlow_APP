<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNote"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke_light"
    app:cardBackgroundColor="?android:attr/colorBackground"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Title and Status Icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tiêu đề ghi chú"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Pinned Icon -->
            <ImageView
                android:id="@+id/ivPinned"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_pin"
                app:tint="@color/pin_color"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                android:contentDescription="@string/pin_note" />

            <!-- Lock Icon -->
            <ImageView
                android:id="@+id/ivLocked"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/warning"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                android:contentDescription="@string/lock_note" />

            <!-- Shared Icon -->
            <ImageView
                android:id="@+id/ivShared"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_share"
                app:tint="@color/primary"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                android:contentDescription="@string/shared_with_me" />
        </LinearLayout>

        <!-- Content Preview -->
        <TextView
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nội dung ghi chú trích đoạn..."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="4"
            android:ellipsize="end"
            android:layout_marginTop="8dp" />

        <!-- Shared Note Meta info -->
        <TextView
            android:id="@+id/tvSharedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <!-- Labels Flow / Chip container -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupLabels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="4dp"
            app:chipSpacingVertical="2dp" />

        <!-- Footer Meta: Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_calendar"
                app:tint="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24/10/2026"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
