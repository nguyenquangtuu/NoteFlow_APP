<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_label"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- Label Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilLabelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_name"
        android:layout_marginTop="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLabelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Color Palette Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_color"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:id="@+id/layoutColors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <!-- 6 Preset Color Views -->
        <View android:id="@+id/color1" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="#4F46E5" />
        <View android:id="@+id/color2" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="#06B6D4" />
        <View android:id="@+id/color3" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="#10B981" />
        <View android:id="@+id/color4" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="#F59E0B" />
        <View android:id="@+id/color5" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="#EF4444" />
        <View android:id="@+id/color6" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="#EC4899" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary" />
    </LinearLayout>

</LinearLayout>
